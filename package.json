{
  "name": "nibble-review",
  "version": "0.2.0",
  "private": true,
  "description": "AML-powered pull request review agent for the Nibble Review GitHub App.",
  "bin": {
    "review_preflight": "dist/cli/preflight.js",
    "review_runner": "dist/cli/review.js"
  },
  "type": "module",
  "scripts": {
    "review": "node dist/cli/review.js",
    "build": "bash scripts/build.sh",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "eval": "node eval/run.mjs",
    "eval:cache": "node eval/cache.mjs",
    "eval:judge": "node eval/judge.mjs",
    "eval:report": "node eval/report.mjs",
    "eval:benchmark": "node eval/benchmark.mjs",
    "lint": "tsc --noEmit && oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@aml-jsx/sdk": "0.8.1",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@octokit/rest": "^22.0.0",
    "pi-acp": "0.0.34",
    "pi-mcp-adapter": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
